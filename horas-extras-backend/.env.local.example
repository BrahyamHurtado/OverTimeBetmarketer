# Template para desarrollo LOCAL. Copiar a `.env.local` y ajustar.
# `.env.local` esta gitignoreado; no se sube al repo ni llega a produccion.

# Secreto JWT solo-local (NO usar el de prod). Cualquier string largo sirve.
JWT_SECRET=local-dev-solo-para-mi-maquina-cambiar-por-uno-largo

# Origen del frontend en local (Modern.js dev server por defecto).
FRONT_ORIGIN=http://localhost:8080
