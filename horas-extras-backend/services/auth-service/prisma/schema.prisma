// Base de datos del auth-service (database-per-service)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

enum Rol {
  EMPLEADO
  SUPERVISOR
  CONTABILIDAD
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  cedula       String   @unique
  correo       String   @unique
  passwordHash String
  cargo        String?
  dependencia  String?
  rol          Rol      @default(EMPLEADO)
  // Supervisor directo del empleado (su "jefe inmediato" / directivo)
  supervisorId String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([rol])
  @@index([supervisorId])
}
